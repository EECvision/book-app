# This file is a template for the environment variables required to run the app.
# Create a .env file locally and fill in the values below.

# Environment: "development" (default local mode) or "production"
NODE_ENV=development

# Only required if NODE_ENV=production
# Connection string for your production PostgreSQL database
DATABASE_URL=postgres://user:password@host:port/db

# Only required if NODE_ENV=production
# Cloudinary URL for uploading images
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
